@model Book_Store.Models.Book

@{
    var primaryImage = Model.BookImages?
        .OrderByDescending(i => i.IsPrimary)
        .ThenBy(i => i.SortOrder)
        .FirstOrDefault();
    var imgSrc = primaryImage?.ImagePath ?? "/images/no-image.png";
}

<div class="product-card" onclick="window.location.href='/Home/ProductDetail/@Model.BookID'" style="cursor:pointer;">
    <div class="card-image-wrapper">
        <img src="@imgSrc" alt="@Model.Title" class="card-image"
             asp-append-version="true"
             onerror="this.src='/images/no-image.png'" />
        <stock-badge stock="@Model.Stock" mode="badge" />
    </div>

    <div class="card-body">
        @if (Model.Category != null)
        {
            <span class="card-category">@Model.Category.Name</span>
        }
        <h3 class="card-title" title="@Model.Title">@Model.Title</h3>
        <div class="card-price">
            <vnd-price value="@Model.Price" />
        </div>
        <div class="card-actions">
            @if (Model.Stock == 0)
            {
                <button class="btn-add-cart" disabled onclick="event.stopPropagation();">
                    <i class="fas fa-shopping-cart"></i> Thêm giỏ hàng
                </button>
            }
            else
            {
                <button class="btn-add-cart" onclick="event.stopPropagation(); addToCart(@Model.BookID, this)">
                    <i class="fas fa-shopping-cart"></i> Thêm giỏ hàng
                </button>
            }
            <a asp-controller="Home" asp-action="ProductDetail"
               asp-route-id="@Model.BookID"
               class="btn-detail" title="Xem chi tiết"
               onclick="event.stopPropagation();">
                <i class="fas fa-eye"></i>
            </a>
        </div>
    </div>
</div>
