@model List<Book_Store.Models.CartItem>
@using Book_Store.Models

@{
    ViewData["Title"] = "Thanh toán";
    var total = Model.Sum(x => x.Price * x.Quantity);
    var currentUser = ViewBag.CurrentUser as User;
}

<link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />>

<div class="container mt-5 mb-5" style="max-width: 1200px;">
    <h2 class="mb-4 text-center text-uppercase fw-bold text-dark">
        <i class="fas fa-credit-card text-orange me-2"></i>THANH TOÁN ĐƠN HÀNG
    </h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3" role="alert">
            <i class="fas fa-exclamation-circle text-danger me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3" role="alert">
            <i class="fas fa-exclamation-triangle text-warning me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- LEFT: Customer info & Shipping Form -->
        <div class="col-lg-7">
            <!-- Customer info card -->
            <div class="card shadow-sm border-0 mb-4 rounded-3" style="border: 1px solid #e2e8f0 !important;">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title mb-0 fw-bold text-secondary" style="font-size: 1.1rem;">
                        <i class="fas fa-user-circle text-orange me-2"></i>Thông tin tài khoản
                    </h5>
                </div>
                <div class="card-body pt-0 pb-3">
                    <div class="row g-3">
                        <div class="col-md-6 py-1">
                            <span class="text-muted d-block small mb-1" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Họ và tên</span>
                            <span class="fw-bold text-dark" style="font-size: 1.05rem;">@(currentUser?.FullName ?? "Chưa thiết lập")</span>
                        </div>
                        <div class="col-md-6 py-1">
                            <span class="text-muted d-block small mb-1" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Email đăng ký</span>
                            <span class="fw-bold text-dark text-truncate d-block" style="font-size: 1.05rem;" title="@(currentUser?.Email ?? "Chưa thiết lập")">@(currentUser?.Email ?? "Chưa thiết lập")</span>
                        </div>
                        <div class="col-md-6 py-1">
                            <span class="text-muted d-block small mb-1" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Tên đăng nhập</span>
                            <span class="fw-bold text-dark" style="font-size: 1.05rem;">@(currentUser?.Username ?? "Chưa thiết lập")</span>
                        </div>
                        <div class="col-md-6 py-1">
                            <span class="text-muted d-block small mb-1" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Số điện thoại</span>
                            <span class="fw-bold text-dark" style="font-size: 1.05rem;">@(currentUser?.PhoneNumber ?? "Chưa thiết lập")</span>
                        </div>
                        <div class="col-md-6 py-1">
                            <span class="text-muted d-block small mb-1" style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Ngày sinh</span>
                            <span class="fw-bold text-dark" style="font-size: 1.05rem;">@(currentUser?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa thiết lập")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Shipping + Payment form card -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title mb-0 fw-bold text-secondary">
                        <i class="fas fa-truck text-orange me-2"></i>Thông tin giao hàng
                    </h5>
                </div>
                <div class="card-body pt-0">

                    <!-- Payment method selector -->
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Chọn phương thức thanh toán</label>
                        <div class="d-flex flex-column gap-3">

                            <!-- COD -->
                            <div class="payment-method-card active" id="methodCOD" onclick="selectPaymentMethod('COD')">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="radio" name="paymentOption" id="radioCOD" checked
                                           class="form-check-input border-2" style="width:20px;height:20px;" />
                                    <i class="fas fa-money-bill-wave text-orange fs-5"></i>
                                    <h6 class="fw-bold mb-0">Thanh toán khi nhận hàng (COD)</h6>
                                </div>
                                <div class="payment-details mt-3 text-muted small ps-5" id="detailsCOD">
                                    <i class="fas fa-info-circle text-orange me-1"></i>
                                    Quý khách thanh toán bằng tiền mặt khi nhận sách. Vui lòng kiểm tra kỹ trước khi nhận.
                                </div>
                            </div>

                            <!-- ── STRIPE (NEW) ── -->
                            <div class="payment-method-card" id="methodStripe" onclick="selectPaymentMethod('Stripe')">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <input type="radio" name="paymentOption" id="radioStripe"
                                               class="form-check-input border-2" style="width:20px;height:20px;" />
                                        <i class="fas fa-credit-card text-orange fs-5"></i>
                                        <h6 class="fw-bold mb-0">Thanh toán bằng thẻ quốc tế</h6>
                                    </div>
                                </div>
                                    
                                <div class="payment-details mt-3 text-muted small ps-5" id="detailsStripe" style="display:none;">
                                    <i class="fas fa-info-circle text-orange me-1"></i>
                                    Thanh toán an toàn qua Stripe — chấp nhận Visa, Mastercard, JCB. Bạn sẽ được chuyển tới trang Stripe bảo mật, sau đó tự động quay lại.
                                    <div class="mt-2 d-flex gap-2 flex-wrap">
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/4/41/Visa_Logo.png"
                                             alt="Visa" style="height:18px; object-fit:contain;" />
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg"
                                             alt="Mastercard" style="height:18px; object-fit:contain;" />
                                    </div>
                                </div>
                            </div>
                            <!-- ── END STRIPE ── -->

                        </div>
                    </div>

                    <!-- COD / Stripe form (shared, method sent via hidden field) -->
                    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
                        <input type="hidden" name="paymentMethod" id="paymentMethodInput" value="COD" />

                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold">Địa chỉ giao hàng nhận sách</label>
                            <input type="text" name="address" class="form-control border-2"
                                   style="padding:10px 14px;border-radius:8px;"
                                   value="@(currentUser?.Address ?? "")"
                                   placeholder="Ví dụ: 123 Nguyễn Huệ, Quận 1, TP.HCM" required />
                        </div>

                        <div class="d-flex justify-content-center mt-4">
                            <button type="button" onclick="submitCheckoutForm()" id="submitBtn"
                                    class="btn btn-orange-gradient px-4 py-2.5 fw-bold shadow-sm"
                                    style="border-radius:8px;min-width:200px;">
                                    XÁC NHẬN ĐẶT HÀNG
                            </button>
                        </div>
                    </form>



                </div>
            </div>
        </div>

        <!-- RIGHT: Order summary -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title mb-0 fw-bold text-secondary">
                        <i class="fas fa-shopping-basket text-orange me-2"></i>Đơn hàng gồm (@Model.Sum(x => x.Quantity) sản phẩm)
                    </h5>
                </div>
                <div class="card-body pt-0">
                    <div class="order-items-list overflow-auto" style="max-height:320px;padding-right:5px;">
                        @foreach (var item in Model)
                        {
                            <div class="d-flex align-items-center gap-3 py-3 border-bottom">
                                <div class="flex-shrink-0" style="width:60px;height:80px;border-radius:6px;overflow:hidden;border:1px solid #eef0f6;">
                                    <img src="@item.Image" alt="@item.ProductName"
                                         style="width:100%;height:100%;object-fit:cover;"
                                         onerror="this.src='/images/no-image.png'" />
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 text-dark fw-bold" title="@item.ProductName"
                                        style="font-size:0.9rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                        @item.ProductName
                                    </h6>
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="text-muted small">
                                            @((item.Price).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))VND × @item.Quantity
                                        </span>
                                        <span class="fw-bold text-primary" style="font-size:0.95rem;">
                                            @((item.Price * item.Quantity).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))VND
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính</span>
                            <span class="fw-bold text-dark">@((total).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))VND</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển</span>
                            <span class="text-success fw-bold">Miễn phí</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Giảm giá</span>
                            <span class="text-muted fw-bold">0 ₫</span>
                        </div>
                        <hr class="my-3" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 fw-bold text-dark">Tổng cộng</span>
                            <span class="h4 mb-0 fw-bold text-danger">@((total).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))VND</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedMethod = 'COD';

    const methods = ['COD', 'Stripe'];

    function selectPaymentMethod(method) {
        selectedMethod = method;

        methods.forEach(m => {
            document.getElementById('method' + m).classList.remove('active');
            document.getElementById('radio' + m).checked = false;
            document.getElementById('details' + m).style.display = 'none';
        });

        document.getElementById('method' + method).classList.add('active');
        document.getElementById('radio' + method).checked = true;
        document.getElementById('details' + method).style.display = 'block';

        document.getElementById('paymentMethodInput').value = method;

        const submitBtn = document.getElementById('submitBtn');
        if (method === 'COD') {
            submitBtn.style.setProperty('background', 'linear-gradient(135deg, #ff8a65 0%, #ff5722 100%)', 'important');
            submitBtn.style.setProperty('border-radius', '8px', 'important');
            submitBtn.innerHTML = 'XÁC NHẬN ĐẶT HÀNG';
        } else if (method === 'Stripe') {
            submitBtn.style.setProperty('background', 'linear-gradient(135deg, #ff8a65 0%, #ff5722 100%)', 'important');
            submitBtn.style.setProperty('border-radius', '8px', 'important');
            submitBtn.innerHTML = '<i class="fas fa-lock me-2"></i> THANH TOÁN QUA STRIPE';
        }
    }

    function submitCheckoutForm() {
        const addressInput = document.querySelector('input[name="address"]');
        if (!addressInput.value.trim()) {
            addressInput.reportValidity();
            return;
        }

        // All methods (COD, Stripe) now submit via checkoutForm to create order first
        document.getElementById('checkoutForm').submit();
    }
</script>
