@model List<Book_Store.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    var total = Model.Sum(x => x.Price * x.Quantity);
}

<link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />

<div class="cart-container">
    <div class="cart-title">🛒 GIỎ HÀNG CỦA BẠN</div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3" role="alert">
            <i class="fas fa-exclamation-circle text-danger me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm mb-4 rounded-3" role="alert">
            <i class="fas fa-exclamation-triangle text-warning me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!(Model?.Any() ?? false))
    {
        <div class="text-center text-muted">
            GIỎ HÀNG ĐANG TRỐNG 🥲
        </div>
    }
    else
    {
        <table class="table align-middle cart-table text-center">
            <thead class="table-light">
                <tr>
                    <th>Hình</th>
                    <th>Tên sách</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Tạm tính</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.Image" />
                        </td>
                        <td>@item.ProductName</td>
                        <td>@((item.Price).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))VND</td>
                        <td>
                            <form asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center">
                                <input type="hidden" name="id" value="@item.ProductId" />
                                <div class="input-group input-group-sm justify-content-center" style="width: 100px;">
                                    <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(this, -1)">-</button>
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control quantity-input text-center" readonly />
                                    <button type="button" class="btn btn-outline-secondary" onclick="changeQuantity(this, 1)">+</button>
                                </div>
                            </form>
                        </td>
                        <td>
                            @(((item.Price * item.Quantity)).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))VND
                        </td>
                        <td>
                            <a asp-action="Remove" asp-route-id="@item.ProductId" 
                               class="btn btn-sm btn-danger">
                               Xoá
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-section">
            Tổng cộng: @((total).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))VND
        </div>

        <div class="text-end">
            <a asp-action="Checkout" class="btn checkout-btn">
                 Thanh toán
            </a>
        </div>
    }
</div>

<script>
    function changeQuantity(button, amount) {
        const form = button.closest('form');
        const input = form.querySelector('.quantity-input');
        let currentValue = parseInt(input.value);
        if (isNaN(currentValue)) currentValue = 1;
        let newValue = currentValue + amount;
        if (newValue >= 1) {
            input.value = newValue;
            form.submit();
        }
    }
</script>