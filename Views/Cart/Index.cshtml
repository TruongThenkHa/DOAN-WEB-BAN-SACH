@model List<Book_Store.Models.CartItem>
@* Register your custom tag helper namespace so <vnd-price> is available *@
@addTagHelper *, Book_Store

@{
    ViewData["Title"] = "Giỏ hàng";
}

<style>
    .cart-container {
        max-width: 1000px;
        margin: 50px auto;
        background: #fff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .cart-title {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        margin-bottom: 30px;
    }

    .cart-table img {
        width: 80px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
    }

    .total-section {
        text-align: right;
        margin-top: 20px;
        font-size: 20px;
        font-weight: bold;
    }

    .checkout-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 250px;
        margin: 30px auto 0;
        padding: 12px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 30px;
        background: linear-gradient(135deg, #ff5722, #ff7043) !important;
        color: #fff !important;
        border: none !important;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(255, 87, 34, 0.3);
        text-decoration: none;
    }

    .checkout-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 87, 34, 0.4);
    }
</style>

<div class="cart-container">
    <div class="cart-title">🛒 GIỎ HÀNG CỦA BẠN</div>

    @*
        <component> tag renders the Blazor Server CartTable component.
        param-InitialItems passes the MVC Model (List<CartItem>) into the component.
        render-mode="ServerPrerendered" gives instant first paint + then Blazor takes over.
        After this point, quantity changes and removes happen in C# with no page reload.
    *@
    <component type="typeof(Book_Store.Components.Cart.CartTable)"
               render-mode="ServerPrerendered"
               param-InitialItems="Model" />
</div>
