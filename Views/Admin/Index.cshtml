@using System.Text.Json
@functions {
    string GetStatusClass(Book_Store.Models.OrderStatus status)
    {
        return status switch
        {
            Book_Store.Models.OrderStatus.Pending => "status-pending",
            Book_Store.Models.OrderStatus.Confirmed => "status-confirmed",
            Book_Store.Models.OrderStatus.Shipping => "status-shipping",
            Book_Store.Models.OrderStatus.Completed => "status-completed",
            Book_Store.Models.OrderStatus.Cancelled => "status-cancelled",
            _ => "status-default"
        };
    }

    string GetStatusText(Book_Store.Models.OrderStatus status)
    {
        return status switch
        {
            Book_Store.Models.OrderStatus.Pending => "Chờ xử lý",
            Book_Store.Models.OrderStatus.Confirmed => "Đã xác nhận",
            Book_Store.Models.OrderStatus.Shipping => "Đang giao hàng",
            Book_Store.Models.OrderStatus.Completed => "Hoàn thành",
            Book_Store.Models.OrderStatus.Cancelled => "Đã hủy",
            _ => status.ToString()
        };
    }
}
@{
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
    ViewData["Title"] = "Tổng quan";

    var jsonOptions = new JsonSerializerOptions
    {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-list.css" asp-append-version="true" />
}

<div class="admin-page dashboard-page">
    <div class="page-header">
        <h1 class="page-title">TỔNG QUAN HỆ THỐNG</h1>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <!-- Doanh thu -->
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-icon stat-icon-green">
                    <i class="fas fa-coins"></i>
                </div>
                @{
                    double revGrowth = ViewBag.RevenueGrowth;
                    string revGrowthClass = revGrowth >= 0 ? "trend-up" : "trend-down";
                    string revGrowthIcon = revGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                }
                <span class="trend-indicator @revGrowthClass">
                    <i class="fas @revGrowthIcon"></i> @Math.Abs(revGrowth).ToString("F1")%
                </span>
            </div>
            <div class="stat-info">
                <span class="stat-label">Tổng doanh thu</span>
                <span class="stat-number">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</span>
            </div>
        </div>

        <!-- Đơn hàng -->
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-icon stat-icon-blue">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                @{
                    double ordGrowth = ViewBag.OrdersGrowth;
                    string ordGrowthClass = ordGrowth >= 0 ? "trend-up" : "trend-down";
                    string ordGrowthIcon = ordGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                }
                <span class="trend-indicator @ordGrowthClass">
                    <i class="fas @ordGrowthIcon"></i> @Math.Abs(ordGrowth).ToString("F1")%
                </span>
            </div>
            <div class="stat-info">
                <span class="stat-label">Tổng đơn hàng</span>
                <span class="stat-number">@ViewBag.TotalOrders</span>
            </div>
        </div>

        <!-- Khách hàng -->
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-icon stat-icon-purple">
                    <i class="fas fa-users"></i>
                </div>
                @{
                    double usrGrowth = ViewBag.UsersGrowth;
                    string usrGrowthClass = usrGrowth >= 0 ? "trend-up" : "trend-down";
                    string usrGrowthIcon = usrGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                }
                <span class="trend-indicator @usrGrowthClass">
                    <i class="fas @usrGrowthIcon"></i> @Math.Abs(usrGrowth).ToString("F1")%
                </span>
            </div>
            <div class="stat-info">
                <span class="stat-label">Tổng khách hàng</span>
                <span class="stat-number">@ViewBag.TotalUsers</span>
            </div>
        </div>

        <!-- Sản phẩm -->
        <div class="stat-card">
            <div class="stat-card-header">
                <div class="stat-icon stat-icon-orange">
                    <i class="fas fa-book"></i>
                </div>
                @{
                    double bksGrowth = ViewBag.BooksGrowth;
                    string bksGrowthClass = bksGrowth >= 0 ? "trend-up" : "trend-down";
                    string bksGrowthIcon = bksGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                }
                <span class="trend-indicator @bksGrowthClass">
                    <i class="fas @bksGrowthIcon"></i> @Math.Abs(bksGrowth).ToString("F1")%
                </span>
            </div>
            <div class="stat-info">
                <span class="stat-label">Tổng sản phẩm</span>
                <span class="stat-number">@ViewBag.TotalBooks</span>
            </div>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="charts-grid">
        <!-- Revenue Chart -->
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-chart-line" style="color: var(--primary);"></i> Doanh thu 7 ngày qua
                </h3>
            </div>
            <div class="chart-container">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Order Status Doughnut Chart -->
        <div class="chart-card">
            <div class="chart-header">
                <h3 class="chart-title">
                    <i class="fas fa-chart-pie" style="color: #8b5cf6;"></i> Phân bố trạng thái đơn hàng
                </h3>
            </div>
            <div class="chart-container">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Split Sections (Recent Orders & Low Stock Warnings) -->
    <div class="dashboard-sections">
        <!-- Đơn hàng gần đây -->
        <div class="card dashboard-card">
            <h2 class="section-title">
                <i class="fas fa-history title-icon-blue"></i> Đơn hàng gần đây
            </h2>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.RecentOrders != null && ((List<Book_Store.Models.Order>)ViewBag.RecentOrders).Count > 0)
                        {
                            @foreach (var order in (List<Book_Store.Models.Order>)ViewBag.RecentOrders)
                            {
                                var itemsJson = JsonSerializer.Serialize(order.OrderDetails.Select(od => new
                                {
                                    title = od.Book?.Title ?? "Sách không xác định",
                                    price = od.Price,
                                    quantity = od.Quantity
                                }), jsonOptions);

                                <tr class="order-row-clickable btn-open-detail" 
                                    data-id="@order.OrderID"
                                    data-customer="@order.CustomerName"
                                    data-phone="@order.PhoneNumber"
                                    data-address="@order.ShippingAddress"
                                    data-date="@order.OrderDate.ToString("dd/MM/yyyy HH:mm")"
                                    data-amount="@order.TotalAmount.ToString("N0") đ"
                                    data-payment="@order.PaymentMethod"
                                    data-status="@GetStatusText(order.Status)"
                                    data-status-class="@GetStatusClass(order.Status)"
                                    data-items="@itemsJson"
                                    data-bs-toggle="modal" 
                                    data-bs-target="#modalDashboardOrderDetail">
                                    <td><strong>#@order.OrderID</strong></td>
                                    <td>
                                        <div class="order-customer-cell">
                                            <span class="order-customer-name">@order.CustomerName</span>
                                            <span class="order-customer-phone">@order.PhoneNumber</span>
                                        </div>
                                    </td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="order-amount">@order.TotalAmount.ToString("N0") đ</td>
                                    <td>
                                        <span class="status-badge @GetStatusClass(order.Status)">
                                            @GetStatusText(order.Status)
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="empty-state">
                                    Không có đơn hàng nào gần đây.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dashboard-card-action">
                <a href="/Admin/OrderList">Xem tất cả đơn hàng <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>

        <!-- Cảnh báo tồn kho -->
        <div class="card dashboard-card">
            <h2 class="section-title">
                <i class="fas fa-exclamation-triangle title-icon-orange"></i> Cảnh báo hết hàng
            </h2>
            <div class="low-stock-list">
                @if (ViewBag.LowStockBooks != null && ((List<Book_Store.Models.Book>)ViewBag.LowStockBooks).Count > 0)
                {
                    @foreach (var book in (List<Book_Store.Models.Book>)ViewBag.LowStockBooks)
                    {
                        var percentage = book.Stock <= 0 ? 0 : (int)((book.Stock / 5.0) * 100);
                        <div class="low-stock-item">
                            <div class="low-stock-meta">
                                <div class="low-stock-info">
                                    <span class="low-stock-title" title="@book.Title">@book.Title</span>
                                    <span class="low-stock-cat">@(book.Category?.Name ?? "Chưa phân loại")</span>
                                </div>
                                <span class="low-stock-number @(book.Stock == 0 ? "low-stock-number-out" : "low-stock-number-low")">
                                    @(book.Stock == 0 ? "Out of stock" : $"Còn {book.Stock}")
                                </span>
                            </div>
                            
                            <!-- Custom Progress Bar -->
                            <div class="stock-progress-container">
                                <div class="stock-progress-bar @(book.Stock == 0 ? "progress-out" : "progress-low")" 
                                     style="width: @(percentage)%;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        Không có cảnh báo tồn kho thấp.
                    </div>
                }
            </div>
            <div class="dashboard-card-action">
                <a href="/Admin/Inventory">Quản lý kho hàng <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết Đơn hàng -->
<div class="modal fade" id="modalDashboardOrderDetail" tabindex="-1" aria-labelledby="modalDashboardOrderDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow);">
            <div class="modal-header" style="border-bottom: 1px solid var(--line); padding: 18px 24px; background-color: #f8fafc;">
                <h5 class="modal-title" id="modalDashboardOrderDetailLabel" style="font-weight: 700; color: var(--text); font-size: 18px;">CHI TIẾT ĐƠN HÀNG <span id="detailOrderId" style="color: var(--primary);"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 14px; color: var(--muted);"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <!-- General Info Grid -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 14px; margin-bottom: 24px;">
                    <div style="background-color: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--line);">
                        <span style="color: var(--muted); font-size: 11px; font-weight: 700; display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;">Khách hàng</span>
                        <strong id="detailCustomer" style="color: var(--text); font-size: 15px;"></strong>
                        <div id="detailPhone" style="color: var(--text); margin-top: 2px; font-weight: 600;"></div>
                    </div>
                    <div style="background-color: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--line);">
                        <span style="color: var(--muted); font-size: 11px; font-weight: 700; display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;">Thông tin đơn</span>
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                            <div>
                                <div id="detailDate" style="color: var(--text); font-weight: 600;"></div>
                                <div id="detailPayment" style="font-size: 12px; color: var(--muted); margin-top: 2px;"></div>
                            </div>
                            <span id="detailStatus" class="status-badge"></span>
                        </div>
                    </div>
                    <div style="grid-column: span 2; background-color: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--line);">
                        <span style="color: var(--muted); font-size: 11px; font-weight: 700; display: block; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;">Địa chỉ giao hàng</span>
                        <strong id="detailAddress" style="color: var(--text); line-height: 1.4;"></strong>
                    </div>
                </div>

                <!-- Products Table -->
                <div style="font-weight: 700; color: var(--text); font-size: 15px; border-left: 3px solid var(--primary); padding-left: 8px; margin-bottom: 12px; letter-spacing: 0.5px; text-transform: uppercase;"> 
                    Sách đã đặt
                </div>
                <div class="table-responsive" style="border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-bottom: 16px;">
                    <table class="table" style="margin: 0; font-size: 14px;">
                        <thead style="background-color: #f8fafc;">
                            <tr>
                                <th>Tên sách</th>
                                <th style="text-align: right; width: 120px;">Đơn giá</th>
                                <th style="text-align: center; width: 80px;">SL</th>
                                <th style="text-align: right; width: 140px;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="detailItemsBody">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Total -->
                <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; font-size: 16px; padding-top: 8px;">
                    <span>Tổng thanh toán:</span>
                    <strong id="detailAmount" style="font-size: 20px; color: var(--primary); font-weight: 800;"></strong>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--line); background-color: #f8fafc; padding: 16px 24px; display: flex; justify-content: flex-end;">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal" style="height: 42px; border-radius: 6px; font-weight: 600;">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- 1. BIỂU ĐỒ DOANH THU 7 NGÀY ---
            const revCtx = document.getElementById('revenueChart').getContext('2d');
            const revLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.RevenueLabels));
            const revValues = @Html.Raw(JsonSerializer.Serialize(ViewBag.RevenueValues));

            new Chart(revCtx, {
                type: 'line',
                data: {
                    labels: revLabels,
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: revValues,
                        borderColor: '#2e6bff',
                        backgroundColor: 'rgba(46, 107, 255, 0.05)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 3,
                        pointBackgroundColor: '#2e6bff',
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

            // --- 2. BIỂU ĐỒ TRẠNG THÁI ĐƠN HÀNG ---
            const statusCtx = document.getElementById('statusChart').getContext('2d');
            const statusLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.StatusLabels));
            const statusValues = @Html.Raw(JsonSerializer.Serialize(ViewBag.StatusValues));

            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusValues,
                        backgroundColor: [
                            '#fff3cd', // Pending (Pastel yellow)
                            '#cce5ff', // Confirmed (Pastel blue)
                            '#e2e3e5', // Shipping (Pastel grey)
                            '#d1e7dd', // Completed (Pastel green)
                            '#f8d7da'  // Cancelled (Pastel red)
                        ],
                        borderColor: '#ffffff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 14 }
                        }
                    },
                    cutout: '65%'
                }
            });

            // --- 3. ĐỌC CHI TIẾT ĐƠN HÀNG LÊN MODAL ---
            document.addEventListener('click', function(e) {
                const trigger = e.target.closest('.btn-open-detail');
                if (!trigger) return;

                const id = trigger.getAttribute('data-id');
                const customer = trigger.getAttribute('data-customer');
                const phone = trigger.getAttribute('data-phone');
                const address = trigger.getAttribute('data-address');
                const date = trigger.getAttribute('data-date');
                const amount = trigger.getAttribute('data-amount');
                const payment = trigger.getAttribute('data-payment');
                const status = trigger.getAttribute('data-status');
                const statusClass = trigger.getAttribute('data-status-class');
                const itemsJson = trigger.getAttribute('data-items') || '[]';

                document.getElementById('detailOrderId').textContent = '#' + id;
                document.getElementById('detailCustomer').textContent = customer;
                document.getElementById('detailPhone').textContent = phone;
                document.getElementById('detailAddress').textContent = address;
                document.getElementById('detailDate').textContent = date;
                document.getElementById('detailPayment').textContent = 'Thanh toán: ' + payment;
                document.getElementById('detailAmount').textContent = amount;

                const statusEl = document.getElementById('detailStatus');
                statusEl.textContent = status;
                statusEl.className = 'status-badge ' + statusClass;

                const items = JSON.parse(itemsJson);
                const body = document.getElementById('detailItemsBody');
                body.innerHTML = '';

                items.forEach(function(item) {
                    const row = document.createElement('tr');

                    const titleCell = document.createElement('td');
                    titleCell.textContent = item.title;
                    row.appendChild(titleCell);

                    const priceCell = document.createElement('td');
                    priceCell.style.textAlign = 'right';
                    priceCell.textContent = item.price.toLocaleString('vi-VN') + ' đ';
                    row.appendChild(priceCell);

                    const qtyCell = document.createElement('td');
                    qtyCell.style.textAlign = 'center';
                    qtyCell.textContent = item.quantity;
                    row.appendChild(qtyCell);

                    const subtotalCell = document.createElement('td');
                    subtotalCell.style.textAlign = 'right';
                    subtotalCell.style.fontWeight = '600';
                    subtotalCell.textContent = (item.price * item.quantity).toLocaleString('vi-VN') + ' đ';
                    row.appendChild(subtotalCell);

                    body.appendChild(row);
                });
            });
        });
    </script>
}
