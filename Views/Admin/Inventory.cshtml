@model List<Book_Store.Models.Book>
@{
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
    ViewData["Title"] = "Quản lý kho hàng";
    string q = ViewBag.Query;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="page-header">
        <h1 class="page-title">QUẢN LÝ KHO HÀNG</h1>

        <div class="toolbar">
            <form method="get" class="search-box" action="/Admin/Inventory" style="position: relative;">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none">
                    <path d="M21 21l-4.3-4.3m1.3-5.2a7 7 0 11-14 0 7 7 0 0114 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <input name="q" id="adminInventorySearchInput" value="@q" placeholder="Tìm tên sách, danh mục..." autocomplete="off" style="min-width: 320px;" />
                <select name="stockStatus" class="input" onchange="this.form.submit()">
                    <option value="">Tất cả trạng thái kho</option>
                    <option value="in" selected="@(ViewBag.StockStatus == "in" ? "selected" : null)">Còn hàng (>= 5)</option>
                    <option value="low" selected="@(ViewBag.StockStatus == "low" ? "selected" : null)">Sắp hết hàng (1-4)</option>
                    <option value="out" selected="@(ViewBag.StockStatus == "out" ? "selected" : null)">Hết hàng (0)</option>
                </select>
            </form>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-custom-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <div class="alert-custom-flex">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink: 0; color: #842029;">
                    <circle cx="12" cy="12" r="10" fill="#842029"/>
                    <path d="M12 8v4M12 16h.01" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>@TempData["Error"]</span>
            </div>
            <button type="button" class="alert-custom-close btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-custom-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <div class="alert-custom-flex">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink: 0; color: #0f5132;">
                    <circle cx="12" cy="12" r="10" fill="#0f5132"/>
                    <path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="alert-custom-close btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>SẢN PHẨM</th>
                    <th>THỂ LOẠI</th>
                    <th>GIÁ BÁN</th>
                    <th>TỒN KHO</th>
                    <th>TRẠNG THÁI</th>
                    <th style="width: 200px; text-align: left;">CẬP NHẬT NHANH</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="text-align:center; color:#667085; padding:28px;">
                            Không tìm thấy sản phẩm nào trong kho.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var book in Model)
                    {
                        var primaryImg = book.BookImages?.FirstOrDefault(i => i.IsPrimary) ?? book.BookImages?.FirstOrDefault();
                        <tr>
                            <td>
                                <span style="font-weight: 600; color: var(--muted);">#@book.BookID</span>
                            </td>
                            <td>
                                <div class="book-item">
                                    @if (primaryImg != null)
                                    {
                                        <img src="@primaryImg.ImagePath" class="book-img" alt="@book.Title" />
                                    }
                                    else
                                    {
                                        <div class="book-placeholder-img">
                                            <i class="fas fa-book"></i>
                                        </div>
                                    }
                                    <div style="font-weight: 700; color: var(--text);">@book.Title</div>
                                </div>
                            </td>
                            <td>
                                @if (book.Category != null)
                                {
                                    <span class="category-badge cat-blue">@book.Category.Name</span>
                                }
                                else
                                {
                                    <span class="category-badge cat-default">Chưa chọn</span>
                                }
                            </td>
                            <td>
                                <strong style="font-size: 14px; color: var(--text);">@book.Price.ToString("N0") đ</strong>
                            </td>
                            <td>
                                <strong style="font-size: 16px; color: var(--text);">@book.Stock</strong>
                            </td>
                            <td>
                                @if (book.Stock <= 0)
                                {
                                    <div class="stock-indicator stock-out">
                                        <span class="stock-dot"></span> Hết hàng
                                    </div>
                                }
                                else if (book.Stock < 5)
                                {
                                    <div class="stock-indicator stock-low">
                                        <span class="stock-dot"></span> Sắp hết hàng
                                    </div>
                                }
                                else
                                {
                                    <div class="stock-indicator stock-high">
                                        <span class="stock-dot"></span> Còn hàng
                                    </div>
                                }
                            </td>
                            <td>
                                <form method="post" action="/Admin/UpdateStock" class="stock-adjust-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@book.BookID" />
                                    <input type="number" name="stock" class="stock-input form-control" value="@book.Stock" min="0" required autocomplete="off" />
                                    <button type="submit" class="btn-stock-save">Lưu</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination-container">
                <div class="pagination-info">
                    Hiển thị trang @ViewBag.CurrentPage / @ViewBag.TotalPages (Tổng cộng @ViewBag.TotalItems sản phẩm)
                </div>
                <div class="pagination-buttons">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a class="pagination-btn" href="@Url.Action("Inventory", new { q = ViewBag.Query, stockStatus = ViewBag.StockStatus, page = 1 })">&laquo;</a>
                        <a class="pagination-btn" href="@Url.Action("Inventory", new { q = ViewBag.Query, stockStatus = ViewBag.StockStatus, page = ViewBag.CurrentPage - 1 })">&lsaquo;</a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">&laquo;</span>
                        <span class="pagination-btn disabled">&lsaquo;</span>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        if (i == ViewBag.CurrentPage)
                        {
                            <span class="pagination-btn active">@i</span>
                        }
                        else
                        {
                            <a class="pagination-btn" href="@Url.Action("Inventory", new { q = ViewBag.Query, stockStatus = ViewBag.StockStatus, page = i })">@i</a>
                        }
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a class="pagination-btn" href="@Url.Action("Inventory", new { q = ViewBag.Query, stockStatus = ViewBag.StockStatus, page = ViewBag.CurrentPage + 1 })">&rsaquo;</a>
                        <a class="pagination-btn" href="@Url.Action("Inventory", new { q = ViewBag.Query, stockStatus = ViewBag.StockStatus, page = ViewBag.TotalPages })">&raquo;</a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">&rsaquo;</span>
                        <span class="pagination-btn disabled">&raquo;</span>
                    }
                </div>
            </div>
        }
    </div>
</div>
