@model List<Book_Store.Models.Publisher>

@{
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
    ViewData["Title"] = "Nhà xuất bản";
    string q = Context.Request.Query["q"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
}

<div class="admin-page">

    <div class="page-header">
        <h1 class="page-title">NHÀ XUẤT BẢN</h1>

        <div class="toolbar">
            <form method="get" class="search-box" action="/Publishers/Index" style="position: relative;">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none">
                    <path d="M21 21l-4.3-4.3m1.3-5.2a7 7 0 11-14 0 7 7 0 0114 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                <input name="q" id="adminPublishersSearchInput" value="@q" placeholder="Tìm kiếm" autocomplete="off" />
                <div id="adminPublishersSearchSuggestions" class="search-suggestions-dropdown"></div>
            </form>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCreatePublisher">
                + Thêm nhà xuất bản
            </button>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-custom-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <div class="alert-custom-flex">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink: 0; color: #842029;">
                    <circle cx="12" cy="12" r="10" fill="#842029"/>
                    <path d="M12 8v4M12 16h.01" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>@TempData["Error"]</span>
            </div>
            <button type="button" class="alert-custom-close btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-custom-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <div class="alert-custom-flex">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink: 0; color: #0f5132;">
                    <circle cx="12" cy="12" r="10" fill="#0f5132"/>
                    <path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="alert-custom-close btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="bulkbar" class="bulkbar">
        <div class="bulk-left">
            <strong id="selectedCount">0</strong> đã chọn
            <button type="button" class="btn btn-ghost" id="clearSelect">Bỏ chọn</button>
        </div>

        <form id="bulkDeleteForm" method="post" action="/Publishers/BulkDelete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ids" id="bulkIds" />
            <button type="button" class="btn btn-danger" id="openBulkDelete">Xóa đã chọn</button>
        </form>
    </div>

    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th class="cell-check">
                        <input type="checkbox" class="checkbox" id="checkAll" />
                    </th>
                    <th>Tên nhà xuất bản</th>
                    <th class="cell-actions">Hành vi</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" style="text-align:center; color:#667085; padding:28px;">
                            Chưa có nhà xuất bản.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model)
                    {
                        <tr>
                            <td class="cell-check">
                                <input type="checkbox" class="checkbox row-check" value="@p.PublisherID" />
                            </td>

                            <td>
                                <div class="cat">
                                    <div class="badge">P</div>
                                    <div class="cat-name">
                                        <strong>@p.Name</strong>
                                        <span>id#@p.PublisherID</span>
                                    </div>
                                </div>
                            </td>

                            <td class="cell-actions">
                                <div class="actions">
                                    <button type="button" class="icon-btn icon-btn-edit btn-open-edit" data-id="@p.PublisherID" data-name="@p.Name" data-bs-toggle="modal" data-bs-target="#modalEditPublisher" title="Sửa">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none">
                                            <path d="M12 20h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                            <path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4 12.5-12.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                                        </svg>
                                    </button>

                                    <button type="button"
                                            class="icon-btn icon-btn-hide btn-open-delete"
                                            data-id="@p.PublisherID"
                                            data-name="@p.Name"
                                            title="Xóa">
                                        <svg class="icon" viewBox="0 0 24 24" fill="none">
                                            <path d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                            <path d="M8 6V4h8v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                            <path d="M6 6l1 16h10l1-16" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination-container">
                <div class="pagination-info">
                    Hiển thị trang @ViewBag.CurrentPage / @ViewBag.TotalPages (Tổng cộng @ViewBag.TotalItems nhà xuất bản)
                </div>
                <div class="pagination-buttons">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a class="pagination-btn" href="@Url.Action("Index", new { q = ViewBag.Query, page = 1 })">&laquo;</a>
                        <a class="pagination-btn" href="@Url.Action("Index", new { q = ViewBag.Query, page = ViewBag.CurrentPage - 1 })">&lsaquo;</a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">&laquo;</span>
                        <span class="pagination-btn disabled">&lsaquo;</span>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        if (i == ViewBag.CurrentPage)
                        {
                            <span class="pagination-btn active">@i</span>
                        }
                        else
                        {
                            <a class="pagination-btn" href="@Url.Action("Index", new { q = ViewBag.Query, page = i })">@i</a>
                        }
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a class="pagination-btn" href="@Url.Action("Index", new { q = ViewBag.Query, page = ViewBag.CurrentPage + 1 })">&rsaquo;</a>
                        <a class="pagination-btn" href="@Url.Action("Index", new { q = ViewBag.Query, page = ViewBag.TotalPages })">&raquo;</a>
                    }
                    else
                    {
                        <span class="pagination-btn disabled">&rsaquo;</span>
                        <span class="pagination-btn disabled">&raquo;</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Delete Confirmation -->
<div class="modal fade" id="modalDeleteConfirm" tabindex="-1" aria-labelledby="modalDeleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow);">
            <div class="modal-header" style="border-bottom: 1px solid var(--line); padding: 18px 24px;">
                <h5 class="modal-title" id="modalDeleteConfirmLabel" style="font-weight: 700; color: var(--text); font-size: 18px;">XÁC NHẬN XÓA</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 14px; color: var(--muted);"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <p id="deleteConfirmText" style="font-size: 15px; color: var(--text); margin: 0; font-weight: 500;">
                    Bạn có chắc chắn muốn xóa nhà xuất bản này không?
                </p>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--line); background-color: #f8fafc; padding: 16px 24px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal" style="height: 42px; border-radius: 6px; font-weight: 600;">Hủy</button>
                
                <form id="deleteConfirmFormSingle" method="post" action="/Publishers/Delete" style="display:none; margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteConfirmSingleId" />
                    <button type="submit" class="btn btn-danger-solid" style="height: 42px; border-radius: 6px; font-weight: 600;">Xóa</button>
                </form>

                <form id="deleteConfirmFormBulk" method="post" action="/Publishers/BulkDelete" style="display:none; margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ids" id="deleteConfirmBulkIds" />
                    <button type="submit" class="btn btn-danger-solid" style="height: 42px; border-radius: 6px; font-weight: 600;">Xóa đã chọn</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Create Publisher -->
<div class="modal fade" id="modalCreatePublisher" tabindex="-1" aria-labelledby="modalCreatePublisherLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 540px;">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow);">
            <form method="post" action="/Publishers/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="border-bottom: 1px solid var(--line); padding: 18px 24px;">
                    <h5 class="modal-title" id="modalCreatePublisherLabel" style="font-weight: 700; color: var(--text); font-size: 18px;">THÊM NHÀ XUẤT BẢN</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 14px; color: var(--muted);"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <div class="field">
                        <div class="label label-large" style="margin-bottom: 8px;">Tên nhà xuất bản</div>
                        <input name="Name" class="input form-control" placeholder="VD: Nhà xuất bản Kim Đồng" required autocomplete="off" style="width: 100%; height: 48px; border-radius: 8px; border: 1px solid var(--line);" />
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--line); background-color: #f8fafc; padding: 16px 24px; display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal" style="height: 42px; border-radius: 6px; font-weight: 600;">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="height: 42px; border-radius: 6px; font-weight: 600;">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Publisher -->
<div class="modal fade" id="modalEditPublisher" tabindex="-1" aria-labelledby="modalEditPublisherLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 540px;">
        <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow);">
            <form id="editPublisherForm" method="post" action="/Publishers/Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PublisherID" id="editPublisherId" />
                <div class="modal-header" style="border-bottom: 1px solid var(--line); padding: 18px 24px;">
                    <h5 class="modal-title" id="modalEditPublisherLabel" style="font-weight: 700; color: var(--text); font-size: 18px;">SỬA NHÀ XUẤT BẢN</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="font-size: 14px; color: var(--muted);"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <div class="field">
                        <div class="label label-large" style="margin-bottom: 8px;">Tên nhà xuất bản</div>
                        <input name="Name" id="editPublisherName" class="input form-control" required autocomplete="off" style="width: 100%; height: 48px; border-radius: 8px; border: 1px solid var(--line);" />
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--line); background-color: #f8fafc; padding: 16px 24px; display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal" style="height: 42px; border-radius: 6px; font-weight: 600;">Hủy</button>
                    <button type="submit" class="btn btn-primary" style="height: 42px; border-radius: 6px; font-weight: 600;">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const checkAll = document.getElementById('checkAll');
            const checks = () => Array.from(document.querySelectorAll('.row-check'));
            const bulkbar = document.getElementById('bulkbar');
            const selectedCount = document.getElementById('selectedCount');
            const bulkIds = document.getElementById('bulkIds');
            const clearBtn = document.getElementById('clearSelect');

            function refreshBulk() {
                const selected = checks().filter(x => x.checked).map(x => x.value);
                selectedCount.textContent = selected.length;
                bulkIds.value = selected.join(',');
                bulkbar.classList.toggle('show', selected.length > 0);
                if (checkAll) checkAll.checked = selected.length > 0 && selected.length === checks().length;
            }

            if (checkAll) {
                checkAll.addEventListener('change', function () {
                    checks().forEach(x => x.checked = checkAll.checked);
                    refreshBulk();
                });
            }

            document.addEventListener('change', function (e) {
                if (e.target && e.target.classList.contains('row-check')) refreshBulk();
            });

            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    checks().forEach(x => x.checked = false);
                    if (checkAll) checkAll.checked = false;
                    refreshBulk();
                });
            }

            refreshBulk();
        })();

        (function () {
            const modalEl = document.getElementById('modalDeleteConfirm');
            const textEl = document.getElementById('deleteConfirmText');

            const formSingle = document.getElementById('deleteConfirmFormSingle');
            const formBulk = document.getElementById('deleteConfirmFormBulk');
            const singleIdInput = document.getElementById('deleteConfirmSingleId');
            const bulkIdsInput = document.getElementById('deleteConfirmBulkIds');

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-open-delete');
                if (!btn) return;

                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name') || '';

                if (textEl) {
                    textEl.textContent = `Bạn có chắc chắn muốn xóa nhà xuất bản "${name}" (id#${id}) không?`;
                }

                if (formBulk && formSingle && singleIdInput) {
                    formBulk.style.display = 'none';
                    formSingle.style.display = 'inline-flex';
                    singleIdInput.value = id;
                }

                if (modalEl) {
                    const deleteModal = new bootstrap.Modal(modalEl);
                    deleteModal.show();
                }
            });

            const openBulk = document.getElementById('openBulkDelete');
            const bulkHidden = document.getElementById('bulkIds');

            if (openBulk && bulkHidden) {
                openBulk.addEventListener('click', function () {
                    const ids = (bulkHidden.value || '').trim();
                    if (!ids) return;

                    const count = ids.split(',').filter(Boolean).length;
                    if (textEl) {
                        textEl.textContent = `Bạn có chắc chắn muốn xóa ${count} nhà xuất bản đã chọn không?`;
                    }

                    if (formBulk && formSingle && bulkIdsInput) {
                        formSingle.style.display = 'none';
                        formBulk.style.display = 'inline-flex';
                        bulkIdsInput.value = ids;
                    }

                    if (modalEl) {
                        const deleteModal = new bootstrap.Modal(modalEl);
                        deleteModal.show();
                    }
                });
            }
        })();

        (function () {
            const modalCreate = document.getElementById('modalCreatePublisher');
            const modalEdit = document.getElementById('modalEditPublisher');
            const editForm = document.getElementById('editPublisherForm');
            const editId = document.getElementById('editPublisherId');
            const editName = document.getElementById('editPublisherName');

            if (modalCreate) {
                modalCreate.addEventListener('show.bs.modal', function () {
                    const input = modalCreate.querySelector('input[name="Name"]');
                    if (input) { input.value = ''; setTimeout(() => input.focus(), 500); }
                    const error = modalCreate.querySelector('.modal-error');
                    if (error) error.remove();
                });
            }

            if (modalEdit) {
                modalEdit.addEventListener('show.bs.modal', function () {
                    if (editName) { setTimeout(() => editName.focus(), 500); }
                    const error = modalEdit.querySelector('.modal-error');
                    if (error) error.remove();
                });
            }

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-open-edit');
                if (!btn) return;

                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');

                if (editId && editName && editForm) {
                    editId.value = id;
                    editName.value = name;
                    editForm.action = `/Publishers/Edit/${id}`;
                }
            });

            // AJAX submit for Create Publisher
            if (modalCreate) {
                const form = modalCreate.querySelector('form');
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const formData = new FormData(form);
                    const response = await fetch(form.action || '/Publishers/Create', {
                        method: 'POST',
                        body: formData
                    });
                    if (response.redirected || (response.url.indexOf('/Publishers') !== -1 && response.url.indexOf('/Publishers/Create') === -1)) {
                        window.location.reload();
                    } else {
                        const html = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const errorEl = doc.querySelector('.text-danger, [data-valmsg-for="Name"]');
                        const errorMsg = errorEl ? errorEl.textContent.trim() : "Tên nhà xuất bản không hợp lệ hoặc đã tồn tại.";
                        
                        let modalError = form.querySelector('.modal-error');
                        if (!modalError) {
                            modalError = document.createElement('div');
                            modalError.className = 'modal-error text-danger mt-2';
                            modalError.style.fontWeight = 'bold';
                            form.querySelector('.field').appendChild(modalError);
                        }
                        modalError.textContent = errorMsg;
                    }
                });
            }

            // AJAX submit for Edit Publisher
            if (modalEdit && editForm) {
                editForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const formData = new FormData(editForm);
                    const response = await fetch(editForm.action, {
                        method: 'POST',
                        body: formData
                    });
                    if (response.redirected || (response.url.indexOf('/Publishers') !== -1 && response.url.indexOf('/Publishers/Edit') === -1)) {
                        window.location.reload();
                    } else {
                        const html = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const errorEl = doc.querySelector('.text-danger, [data-valmsg-for="Name"]');
                        const errorMsg = errorEl ? errorEl.textContent.trim() : "Tên nhà xuất bản không hợp lệ hoặc đã tồn tại.";
                        
                        let modalError = editForm.querySelector('.modal-error');
                        if (!modalError) {
                            modalError = document.createElement('div');
                            modalError.className = 'modal-error text-danger mt-2';
                            modalError.style.fontWeight = 'bold';
                            editForm.querySelector('.field').appendChild(modalError);
                        }
                        modalError.textContent = errorMsg;
                    }
                });
            }
        })();
    </script>
}

