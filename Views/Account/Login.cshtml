@model Book_Store.ViewModel.users.LoginViewModel

@{
  ViewData["Title"] = "Đăng nhập";
  Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
</head>

<body>

  <div class="auth-container">

    @* Left: image panel — uses .auth-image-section from register.css *@
    <div class="auth-image-section">
      <img src="/images/dangnhap1.jpg" alt="Đăng nhập" />
    </div>

    @* Right: form panel — uses .auth-form-section / .auth-form-wrapper from register.css *@
    <div class="auth-form-section">
      <div class="auth-form-wrapper">

        <h2 class="auth-form-title">Đăng nhập</h2>

        @if (TempData["SuccessMessage"] != null)
        {
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
          <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

          <div class="form-group">
            <label asp-for="Email">Email:</label>
            <input asp-for="Email" type="email" placeholder="example@gmail.com" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
          </div>

          <div class="form-group">
            <label asp-for="Password">Mật khẩu:</label>
            <input asp-for="Password" type="password" placeholder="Nhập mật khẩu" required />
            <span asp-validation-for="Password" class="text-danger small"></span>
          </div>

          <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
          </div>

          <button type="submit" class="submit-btn">Đăng nhập</button>

          <div class="form-links">
            Chưa có tài khoản?
            <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a>
          </div>
        </form>

      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
</body>

</html>
