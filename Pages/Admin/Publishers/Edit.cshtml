@page "{id:int}"
@model Book_Store.Pages.Admin.Publishers.EditModel
@{
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
    ViewData["Title"] = "Chỉnh sửa nhà xuất bản (Razor Pages)";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
}

<div class="admin-page" style="max-width: 600px; margin: 0 auto; padding-top: 20px;">
    <div class="page-header" style="border-bottom: 1px solid var(--line); padding-bottom: 15px; margin-bottom: 20px;">
        <h1 class="page-title" style="font-size: 20px;">CHỈNH SỬA NHÀ XUẤT BẢN (RAZOR PAGES)</h1>
    </div>

    <div class="card p-4 shadow-sm border-0">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Publisher.PublisherID" />

            <div class="form-group mb-3">
                <label asp-for="Publisher.Name" class="form-label fw-bold">Tên nhà xuất bản:</label>
                <input asp-for="Publisher.Name" class="form-control form-control-lg" required autocomplete="off" />
                <span asp-validation-for="Publisher.Name" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-page="./Index" class="btn btn-ghost" style="border: 1px solid var(--line);">Quay lại</a>
                <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>
