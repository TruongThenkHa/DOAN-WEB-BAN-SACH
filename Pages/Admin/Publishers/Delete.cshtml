@page "{id:int}"
@model Book_Store.Pages.Admin.Publishers.DeleteModel
@{
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
    ViewData["Title"] = "Xóa nhà xuất bản (Razor Pages)";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
}

<div class="admin-page" style="max-width: 600px; margin: 0 auto; padding-top: 20px;">
    <div class="page-header" style="border-bottom: 1px solid var(--line); padding-bottom: 15px; margin-bottom: 20px;">
        <h1 class="page-title text-danger" style="font-size: 20px;">XÁC NHẬN XÓA NHÀ XUẤT BẢN (RAZOR PAGES)</h1>
    </div>

    <div class="card p-4 shadow-sm border-0">
        <h5 class="text-danger fw-bold mb-3">Bạn có chắc chắn muốn xóa nhà xuất bản này?</h5>
        
        <table class="table table-bordered mb-4">
            <tr>
                <th style="width: 150px;">Mã nhà xuất bản</th>
                <td>@Model.Publisher.PublisherID</td>
            </tr>
            <tr>
                <th>Tên nhà xuất bản</th>
                <td><strong>@Model.Publisher.Name</strong></td>
            </tr>
        </table>

        <form method="post">
            <input type="hidden" asp-for="Publisher.PublisherID" />
            <div class="d-flex justify-content-between align-items-center">
                <a asp-page="./Index" class="btn btn-ghost" style="border: 1px solid var(--line);">Hủy bỏ</a>
                <button type="submit" class="btn btn-danger px-4">Xóa ngay</button>
            </div>
        </form>
    </div>
</div>
